! Si diamond, two-atom fcc primitive cell (ibrav = 2)
&CONTROL
  calculation = 'scf'
  prefix = 'si'
  pseudo_dir = './pseudo'
  outdir = './tmp'
/
&SYSTEM
  ibrav = 2, celldm(1) = 10.26
  nat = 2, ntyp = 1
  ecutwfc = 30.0
  nbnd = 8
/
&ELECTRONS
  conv_thr = 1.0d-10
  mixing_beta = 0.7
/
ATOMIC_SPECIES
  Si  28.086  Si.header-only.UPF
ATOMIC_POSITIONS crystal
  Si  0.00 0.00 0.00
  Si  0.25 0.25 0.25
K_POINTS automatic
  4 4 4 1 1 1
