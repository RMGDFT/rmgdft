#!/bin/bash
#SBATCH -A m526
#SBATCH -C gpu
#SBATCH -q regular
#SBATCH -t 0:30:00
#SBATCH -N 4
#SBATCH --ntasks-per-node=4
#SBATCH -c 32
#SBATCH --gpus-per-node=4        # CHANGED: Request all 4 GPUs for the node, not per task
#SBATCH -o stdout

module purge
module load PrgEnv-gnu
module load cmake
module load craype-x86-milan
module load cray-fftw
module load cray-hdf5-parallel
module load cudatoolkit
module load nccl

# Enable NERSC's optimized GPU cross-communication protocol over Slingshot
#export MPICH_GPU_SUPPORT_ENABLED=1
export NCCL_NET_GDR_LEVEL=5
export NCCL_DEBUG=INFO

export OMP_NUM_THREADS=8
export RMG_NUM_THREADS=9
export OMP_WAIT_POLICY="passive"

echo "The Job ID is \$SLURM_JOB_ID" > stdout

dir=`pwd`
cd $dir/Si-8atom-2x2x2-double-tiledMM

# ADDED: Explicit GPU binding so each rank cleanly pairs with its closest GPU/CPU domain
srun --cpu_bind=cores ../rmg-gpu input

